# Which chain the site talks to. "devnet" (default) or "mainnet".
# Anything other than mainnet keeps the throwaway /public/dev-wallet.json
# signing path enabled, so this is the switch that matters.
VITE_CLUSTER=devnet

# RPC endpoint. The public ones rate-limit hard; on mainnet a paid endpoint
# (Helius, QuickNode, Triton) is not optional.
VITE_RPC=

# Absolute origin this deployment is reachable at. Used by the metadata server
# for the image URLs inside token metadata — wallets and marketplaces fetch
# those, so a relative path would resolve against their origin and 404.
PUBLIC_URL=https://primates.app
